units       lj
boundary    f f f
atom_style  bond

fix signals all property/atom d2_signals 4 ghost yes
read_data 1Sep_informed_rw_genome.data fix signals NULL Signals

pair_style  lj/episig/cut 2.5

pair_coeff  1 1 0.415 1.0 2.5
pair_coeff  1 2 0.425 1.0 2.5
pair_coeff  2 2 0.55  1.0 2.5

pair_coeff B 1 1 0.01
pair_coeff B 1 2 0.02
pair_coeff B 1 3 0.03
pair_coeff B 1 4 0.04
pair_coeff B 2 2 0.05
pair_coeff B 2 3 0.06
pair_coeff B 2 4 0.07
pair_coeff B 3 3 0.08
pair_coeff B 3 4 0.09
pair_coeff B 4 4 0.10

run 1