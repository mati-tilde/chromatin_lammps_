# Initialization
units		lj 
boundary	f f f
atom_style	bond
log 		log_gyr_test.txt
read_data	init_drosophila.data
variable seed equal 42

# Dreiding potential information
neighbor	0.2 bin
neigh_modify delay 0 every 1 check yes # technical tweaking

bond_style harmonic
bond_coeff 1 40.0 1.0

pair_style	lj/cut 2.5
#1 - A, active edge block
#2 - B, inactive middle block
#3 - Centromeric, telomeric regions
#4 - Centromeric, telomeric regions, fixed points

#definition of the groups
group a_block type 1 # B-block
group b_block type 2 # A-block
group ct type 3 #pericentromers
group for_freeze type 4
group rest subtract all for_freeze

#definition of groups to use one molecule
#group chr1 molecule 1
#group delete subtract all chr1

#deleting all other molecules but one
#delete_atoms group delete 

#confinement
region myCyl cylinder z 0 0 17 0 68 side in
fix wall1 a_block wall/region myCyl lj126 0.15 1.0 2.5
fix wall2 b_block wall/region myCyl lj126 0.15 1.0 2.5
fix wall3 ct wall/region myCyl lj126 0.425 1.0 2.5

fix freeze for_freeze setforce 0.0 0.0 0.0
pair_coeff 1 1  0.415  1.0	2.5 # A-A
pair_coeff 2 2  0.444  1.0	2.5 # B-B
pair_coeff 3 3  0.55  1.0	2.5 # centromere-telomere agregation
pair_coeff 4 4  0.55  1.0	2.5 # centromere-telomere agregation
pair_coeff 3 4  0.55  1.0	2.5 # centromere-telomere agregation
pair_coeff 1 2  0.394  1.0	2.5 # A-B separation
pair_coeff 1 3  0.4  1.0	2.5 # A-C separation
pair_coeff 1 4  0.4  1.0	2.5 # A-C(f) separation
pair_coeff 2 3  0.425  1.0	2.5 # B-C separation
pair_coeff 2 4  0.425  1.0	2.5 # B-C(f) separation

# computing gyration radius bead by bead
compute rg all gyration

# Minimization
#fix 1 rest nvt temp 1 1 0.1
thermo 1000
thermo_style custom step pe fnorm #lx ly lz press pxx pyy pzz
min_style cg
minimize  0 1.0e-9 30000 300000
#unfix 1


write_data 	after_minim.mpiio

#####################################################
# RUN  
thermo_modify flush yes

velocity rest create 1.0 ${seed} rot yes dist gaussian
timestep 0.02

fix 1 rest nvt temp 1.0 1.0 0.1
fix rgout all ave/time 1000 1 1000 c_rg file rg.txt mode scalar

restart 100000 old_tmp_rst new_tmp_rst
thermo 10000
thermo_style	custom step temp pe etotal evdwl c_rg


#dump command
dump 1 all custom 20000 traj_gyr_test.lammpstrj id type x y z 
run 1000000
write_data 	final_conf.mpiio

print "All done"
