units           lj
boundary        f f f
atom_style      bond

fix             signals all property/atom d2_signals 3 ghost yes
read_data       ${data} fix signals NULL Signals
read_data       23Oct_chr2_rw_seed42_without_H3K27ac.data fix signals NULL Signals
Reading data file ...
  orthogonal box = (-30 -30 -2) to (30 30 70)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4881 atoms
  scanning bonds ...
  1 = max bonds/atom
  orthogonal box = (-30 -30 -2) to (30 30 70)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  4880 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
     6 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_data CPU = 0.022 seconds

neighbor        ${skin} bin
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 3.5

bond_style  harmonic
bond_coeff 1 40.0 1.0                   # for a spring constant of k' = 2k = 80
special_bonds   lj 0.0 0.0 0.0          # to allow sum over only non-directly bonded pairs.
#-------------------------------------------------------------------------------------------


#-------------------------------------------------------------------------------------------
# Interactions.

pair_style hybrid/overlay lj/cut 1.122462 sigmoid/episig 3 ${r_cut}     # allow usage of different pair_styles.
pair_style hybrid/overlay lj/cut 1.122462 sigmoid/episig 3 3.0     
pair_coeff * * lj/cut ${eps_w} 1.0 1.122462         # WCA core: LJ cut at r_min = 2^(1/6).
pair_coeff * * lj/cut 0.415 1.0 1.122462         
pair_coeff * * sigmoid/episig ${C} ${r_c} ${mu}
pair_coeff * * sigmoid/episig 0.1 ${r_c} ${mu}
pair_coeff * * sigmoid/episig 0.1 1.78 ${mu}
pair_coeff * * sigmoid/episig 0.1 1.78 3.22

pair_coeff      * * sigmoid/episig B 1 1 ${B11}     # introducing B entries: only the second pair_style uses them.
pair_coeff      * * sigmoid/episig B 1 1 0.25     
pair_coeff      * * sigmoid/episig B 1 2 ${B12}
pair_coeff      * * sigmoid/episig B 1 2 0.25
pair_coeff      * * sigmoid/episig B 1 3 ${B13}
pair_coeff      * * sigmoid/episig B 1 3 0.25
pair_coeff      * * sigmoid/episig B 2 2 ${B22}
pair_coeff      * * sigmoid/episig B 2 2 0.25
pair_coeff      * * sigmoid/episig B 2 3 ${B23}
pair_coeff      * * sigmoid/episig B 2 3 0.25
pair_coeff      * * sigmoid/episig B 3 3 ${B33}
pair_coeff      * * sigmoid/episig B 3 3 0.25

pair_modify     shift yes                           # required both for WCA core and contact attraction.
#-------------------------------------------------------------------------------------------


#-------------------------------------------------------------------------------------------
# Groups and confinement.

group       for_freeze type 2
4 atoms in group for_freeze
group       rest subtract all for_freeze
4877 atoms in group rest

region		Cyl cylinder z 0 0 28 -1 69 side in
fix		    nucleus all wall/region Cyl lj126 0.15 1.0 2.5

# to include wall energy in total energy (needed to check energy conservation correctly):
fix_modify  nucleus energy yes

fix         freeze for_freeze setforce 0.0 0.0 0.0
#-------------------------------------------------------------------------------------------


#-------------------------------------------------------------------------------------------
# Observables.

# components of Phi matrix (six for three sig/ten for four sig) and number of contacts N_c.
compute     episig all pair sigmoid/episig
variable    N_c equal c_episig[7]               # for three signals.

# linearity check: must be ca. 0 at every step.
variable    linres equal c_episig+${C}*c_episig[7]+${B11}*c_episig[1]+${B12}*c_episig[2]+${B13}*c_episig[3]+${B22}*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+${B11}*c_episig[1]+${B12}*c_episig[2]+${B13}*c_episig[3]+${B22}*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+${B12}*c_episig[2]+${B13}*c_episig[3]+${B22}*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+0.25*c_episig[2]+${B13}*c_episig[3]+${B22}*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+0.25*c_episig[2]+0.25*c_episig[3]+${B22}*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+0.25*c_episig[2]+0.25*c_episig[3]+0.25*c_episig[4]+${B23}*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+0.25*c_episig[2]+0.25*c_episig[3]+0.25*c_episig[4]+0.25*c_episig[5]+${B33}*c_episig[6]
variable    linres equal c_episig+0.1*c_episig[7]+0.25*c_episig[1]+0.25*c_episig[2]+0.25*c_episig[3]+0.25*c_episig[4]+0.25*c_episig[5]+0.25*c_episig[6]

# printing raw Phi entries and N_c at every thermo step - python check and optimization.
fix         epi_out all ave/time ${thermo_every} 1 ${thermo_every} c_episig c_episig[*] file ${prefix}_phi.dat format " %.15g"
fix         epi_out all ave/time 100 1 ${thermo_every} c_episig c_episig[*] file ${prefix}_phi.dat format " %.15g"
fix         epi_out all ave/time 100 1 100 c_episig c_episig[*] file ${prefix}_phi.dat format " %.15g"
fix         epi_out all ave/time 100 1 100 c_episig c_episig[*] file B1_sig_dt0.02_phi.dat format " %.15g"

# computing useful quantities.
compute     rg all gyration
compute     coord all coord/atom cutoff ${r_c}
compute     coord all coord/atom cutoff 1.78
compute     coord_avg all reduce ave c_coord

thermo          ${thermo_every}
thermo          100
thermo_style    custom step temp press pe ke etotal ebond evdwl c_episig v_N_c v_linres c_rg c_coord_avg
thermo_modify   flush yes
thermo_modify   format float " %.15g"
#-------------------------------------------------------------------------------------------




