# Stage 3: production.

# for energy-conservation test: -var prod nve gives a pure NVE production run.
if "${prod} == nve" then "unfix thermostat"
unfix thermostat

dump            traj all custom ${dump_every} ${prefix}.lammpstrj id mol type x y z
dump            traj all custom 1000 ${prefix}.lammpstrj id mol type x y z
dump            traj all custom 1000 B1_sig_dt0.005.lammpstrj id mol type x y z
dump_modify     traj sort id

# radial distribution function, g(r): how likely it is to find another bead at distance r from a given bead,
# compared with a completely uniform arrangement at the same average density.
compute         rdf all rdf 125 cutoff 2.5
fix             rdf_out all ave/time $(10*v_thermo_every) 1 $(10*v_thermo_every) c_rdf[*] file ${prefix}.rdf mode vector ave running
