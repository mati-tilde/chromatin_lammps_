velocity        rest create 1.0 ${v_seed} rot yes dist gaussian
velocity        rest create 1.0 42 rot yes dist gaussian
timestep        ${dt}
timestep        0.005
fix             integrate rest nve
fix             thermostat rest langevin ${T} ${T} ${damp} ${l_seed}
fix             thermostat rest langevin 1.0 ${T} ${damp} ${l_seed}
fix             thermostat rest langevin 1.0 1.0 ${damp} ${l_seed}
fix             thermostat rest langevin 1.0 1.0 1.0 ${l_seed}
fix             thermostat rest langevin 1.0 1.0 1.0 928374

run             ${n_eq}
run             1000
